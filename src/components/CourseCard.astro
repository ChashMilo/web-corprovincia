---
import { ArrowUpRight, Clock } from "lucide-astro";

interface Props {
  nombre: string;
  slug: string;
  categoria: string;
  resumen: string;
  imagen: string;
  duracion?: string;
  horario?: string;
  index?: number;
}

const { nombre, slug, categoria, resumen, imagen, duracion, index } = Astro.props;

const isTecnico = categoria === "tecnico";
const categoriaBadge = isTecnico ? "Técnico laboral" : "Curso corto";
---

<article class="pcard group relative h-full overflow-hidden rounded-[1.75rem] bg-night text-white">
  <img src={imagen} alt="" loading="lazy" decoding="async" class="pcard-img absolute inset-0 w-full h-full object-cover" />
  <div class="absolute inset-0 bg-gradient-to-t from-night via-night/70 to-night/5" aria-hidden="true"></div>

  <div class="relative flex flex-col h-full min-h-[26rem] p-6 sm:p-7">
    <div class="flex items-start justify-between gap-3">
      <span class={`tag !text-[0.68rem] px-2.5 py-1 rounded-full ${isTecnico ? "bg-gold !text-night" : "bg-white/15 !text-white backdrop-blur-md"}`}>
        {categoriaBadge}
      </span>
      {typeof index === "number" && (
        <span class="font-mono text-xs text-white/50 tabular">{String(index + 1).padStart(2, "0")}</span>
      )}
    </div>

    <div class="mt-auto">
      <h3 class="font-display text-2xl font-semibold leading-[1.05] tracking-tight">
        <a href={`/cursos/${slug}`} class="pcard-link after:absolute after:inset-0 after:z-10 after:rounded-[inherit]">
          {nombre}
        </a>
      </h3>
      <p class="pcard-text mt-3 text-sm text-white/70 leading-relaxed line-clamp-3">{resumen}</p>
      <div class="mt-5 pt-4 border-t border-white/15 flex items-center justify-between gap-3">
        {duracion ? (
          <span class="flex items-center gap-2 text-xs text-white/65 min-w-0">
            <Clock class="w-3.5 h-3.5 text-gold shrink-0" />
            <span class="truncate">{duracion}</span>
          </span>
        ) : <span />}
        <span class="pcard-arrow flex items-center justify-center w-10 h-10 rounded-full bg-white text-night shrink-0">
          <ArrowUpRight class="w-4 h-4" />
        </span>
      </div>
    </div>
  </div>
</article>

<style>
  .pcard { transition: transform 160ms var(--ease-out); }
  .pcard:active { transform: scale(0.985); }
  .pcard-img { transition: transform 1200ms var(--ease-expo), opacity 500ms ease; opacity: 0.85; }
  .pcard-arrow { transition: transform 600ms var(--ease-expo), background-color 300ms ease; }
  .pcard-link:focus-visible { outline: none; }
  .pcard-link:focus-visible::after { outline: 2px solid var(--color-gold); outline-offset: 3px; }

  @media (hover: hover) and (pointer: fine) {
    .pcard:hover .pcard-img { transform: scale(1.08); opacity: 1; }
    .pcard:hover .pcard-arrow { transform: rotate(45deg); background: var(--color-gold); }
  }
</style>
