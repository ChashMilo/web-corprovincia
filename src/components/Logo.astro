---
interface Props {
  variant?: "auto" | "light" | "dark" | "white";
  class?: string;
}

const { variant = "auto", class: className = "h-11 sm:h-12 w-auto" } =
  Astro.props;

// En fondos oscuros o con variant="white", TODO el logo se muestra en #FFFFFF.
// En modo auto: en claro usa los colores originales (#211b5e y #b88a44) y en modo oscuro se convierte todo a #FFFFFF.
let textColorClass = "fill-[#211b5e] dark:fill-white transition-colors";
let goldColorClass = "fill-[#b88a44] dark:fill-white transition-colors";

if (variant === "white" || variant === "light") {
  textColorClass = "fill-white";
  goldColorClass = "fill-white";
} else if (variant === "dark") {
  textColorClass = "fill-[#211b5e]";
  goldColorClass = "fill-[#b88a44]";
}
