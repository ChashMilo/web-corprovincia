---
import Layout from "../layouts/Layout.astro";
import InscripcionForm from "../components/InscripcionForm.astro";
import ValidacionForm from "../components/ValidacionForm.astro";
import LiceoLogo from "../components/LiceoLogo.astro";
import { ArrowUpRight, ArrowDown, Sun, BookOpenCheck, HeartHandshake, Plus, Equal } from "lucide-astro";

const pilares = [
  {
    icon: Sun,
    title: "Jornada mañana",
    desc: "El bachillerato regular se dicta en jornada de la mañana, de grado 6° a 11°.",
  },
  {
    icon: BookOpenCheck,
    title: "Preparación Saber 11",
    desc: "Refuerzo integrado en lectura crítica, matemáticas, ciencias sociales e inglés.",
  },
  {
    icon: HeartHandshake,
    title: "Acompañamiento cercano",
    desc: "Seguimiento pedagógico personalizado al proceso de cada estudiante y su familia.",
  },
];

const pasosValidacion = [
  { t: "Revisión de certificados", d: "Analizamos tus años cursados para convalidar asignaturas." },
  { t: "Nivelación", d: "Talleres acelerados en las competencias esenciales." },
  { t: "Evaluación", d: "Pruebas por competencias y preparación para Saber 11." },
  { t: "Graduación", d: "Diploma y acta de grado avalados legalmente." },
];
---

<Layout
  title="Liceo Alcira Colón de Ahumada — Bachillerato con doble titulación | Corprovincia"
  description="Bachillerato en jornada mañana con doble titulación y validación de bachillerato en Sabanalarga, Atlántico. Gradúate como bachiller académico y técnico laboral."
>
  <!-- 1. HERO -->
  <section class="on-dark noise min-h-[100svh] flex items-center">
    <div class="aurora" aria-hidden="true"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
    <div class="grid-lines" aria-hidden="true"></div>

    <div class="wrap grid lg:grid-cols-12 gap-12 items-center pt-32 pb-16">
      <div class="lg:col-span-7">
        <div data-reveal>
          <LiceoLogo variant="full" textColor="#ffffff" class="h-14 sm:h-[4.5rem] w-auto" />
        </div>
        <h1 class="display display-xl mt-10" data-split="load">
          Dos títulos.<br /><span class="text-gold">Un camino.</span>
        </h1>
        <p class="lead mt-8 max-w-xl" data-reveal>
          Bachillerato en <strong class="text-white font-semibold">jornada mañana</strong> con doble titulación
          oficial: te gradúas como bachiller académico y como técnico laboral, al mismo tiempo.
        </p>
        <div class="mt-10 flex flex-col sm:flex-row gap-3" data-reveal>
          <a href="#inscripcion-liceo" class="btn btn-gold btn-xl" data-magnetic>
            Inscribirme al Liceo <span class="btn-icon"><ArrowDown class="w-4 h-4" /></span>
          </a>
          <a href="#validacion" class="btn btn-ghost btn-xl">Validar mi bachillerato</a>
        </div>
      </div>

      <div class="lg:col-span-5 relative">
        <div class="aspect-[4/5] rounded-[2rem] overflow-hidden" data-clip>
          <img
            src="/images/liceo/hero-estudiantes-liceo.webp"
            alt="Estudiantes del Liceo Alcira Colón de Ahumada en la Semana Municipal de la Juventud"
            class="w-full h-full object-cover"
            fetchpriority="high"
          />
        </div>
        <div class="chip-float absolute -left-3 sm:-left-8 top-10 rounded-2xl bg-white text-ink px-4 py-3 shadow-2xl shadow-black/40" data-reveal>
          <p class="tag !text-ink-muted">Jornada</p>
          <p class="font-display text-xl font-semibold">Mañana</p>
        </div>
        <div class="shield-float absolute -right-3 sm:-right-7 -top-7 w-24 h-24 sm:w-28 sm:h-28 rounded-[1.75rem] bg-white flex items-center justify-center shadow-2xl shadow-black/50" data-reveal>
          <LiceoLogo class="h-[4.5rem] sm:h-20 w-auto" />
        </div>
        <div class="chip-float-2 absolute -right-2 sm:-right-6 bottom-12 rounded-2xl bg-gold text-night px-4 py-3 shadow-2xl shadow-black/40" data-reveal>
          <p class="tag !text-night/60">Grados</p>
          <p class="font-display text-xl font-semibold">6° a 11°</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. ECUACIÓN DOBLE TITULACIÓN -->
  <section class="py-24 sm:py-32">
    <div class="wrap">
      <div class="max-w-3xl mb-14">
        <p class="tag tag-dot" data-reveal>Doble titulación</p>
        <h2 class="display display-lg mt-6" data-split>Sales del colegio <span class="text-gold-ink">con un oficio.</span></h2>
      </div>

      <div class="grid lg:grid-cols-[1fr_auto_1fr_auto_1fr] items-stretch gap-4">
        <div class="card p-8 flex flex-col min-h-[15rem]" data-reveal>
          <p class="tag">Título 1</p>
          <p class="mt-auto display display-sm">Bachiller académico</p>
          <p class="mt-2 text-ink-soft">Diploma y acta de grado de educación media.</p>
        </div>
        <div class="flex items-center justify-center" data-reveal>
          <span class="w-12 h-12 rounded-full bg-muted flex items-center justify-center"><Plus class="w-5 h-5" /></span>
        </div>
        <div class="card p-8 flex flex-col min-h-[15rem]" data-reveal>
          <p class="tag">Título 2</p>
          <p class="mt-auto display display-sm">Técnico laboral auxiliar</p>
          <p class="mt-2 text-ink-soft">En el área que elijas, certificado por competencias.</p>
        </div>
        <div class="flex items-center justify-center" data-reveal>
          <span class="w-12 h-12 rounded-full bg-muted flex items-center justify-center"><Equal class="w-5 h-5" /></span>
        </div>
        <div class="rounded-[1.5rem] bg-night text-white p-8 flex flex-col min-h-[15rem] on-dark noise" data-reveal>
          <div class="aurora opacity-70" aria-hidden="true"><span class="a2"></span></div>
          <p class="tag !text-gold">Al graduarte</p>
          <p class="mt-auto font-display text-[5rem] leading-none font-semibold tracking-tighter tabular" data-count="2">2</p>
          <p class="mt-2 text-white/70">títulos para trabajar o seguir estudiando con ventaja.</p>
        </div>
      </div>

      <ul class="mt-20 grid md:grid-cols-3 border-t border-line">
        {pilares.map(({ icon: Icon, title, desc }, i) => (
          <li class={`pt-10 pb-4 md:pr-10 ${i > 0 ? 'md:pl-10 md:border-l border-line' : ''}`} data-reveal>
            <Icon class="w-7 h-7 text-gold-ink" />
            <h3 class="mt-6 font-display text-2xl font-semibold tracking-tight">{title}</h3>
            <p class="mt-2 text-ink-soft leading-relaxed">{desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. VALIDACIÓN -->
  <section id="validacion" class="relative overflow-hidden py-24 sm:py-32 bg-gold-soft scroll-mt-24">
    <div class="absolute -right-24 -bottom-24 opacity-[0.07] pointer-events-none" aria-hidden="true" data-parallax="10">
      <LiceoLogo class="h-[38rem] w-auto" />
    </div>
    <div class="wrap relative grid lg:grid-cols-12 gap-14 items-start">
      <div class="lg:col-span-5 lg:sticky lg:top-28">
        <p class="tag tag-dot !text-gold-ink" data-reveal>Validación de bachillerato</p>
        <h2 class="display display-md mt-6" data-split>¿Dejaste el colegio? <span class="text-gold-ink">Termínalo.</span></h2>
        <p class="lead mt-6" data-reveal>
          Con nuestro programa oficial de ciclos lectivos especiales integrados (CLEI) culminas el
          bachillerato en menos tiempo, sin perder calidad académica.
        </p>

        <ol class="mt-10 relative">
          <span class="absolute left-[1.15rem] top-3 bottom-3 w-px bg-ink/15" aria-hidden="true"></span>
          {pasosValidacion.map(({ t, d }, i) => (
            <li class="relative flex gap-5 pb-7 last:pb-0" data-reveal>
              <span class="relative z-10 w-[2.3rem] h-[2.3rem] rounded-full bg-night text-gold font-mono text-xs flex items-center justify-center shrink-0 tabular">
                0{i + 1}
              </span>
              <div class="pt-1.5">
                <p class="font-semibold text-ink">{t}</p>
                <p class="text-ink-soft text-sm mt-0.5">{d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="lg:col-span-7" data-reveal>
        <ValidacionForm />
      </div>
    </div>
  </section>

  <!-- 4. INSCRIPCIÓN -->
  <section id="inscripcion-liceo" class="py-24 sm:py-32 scroll-mt-24">
    <div class="wrap max-w-4xl">
      <div class="text-center mb-12">
        <div class="flex justify-center mb-6" data-reveal><LiceoLogo class="h-24 w-auto" /></div>
        <p class="tag tag-dot justify-center" data-reveal>Admisiones abiertas</p>
        <h2 class="display display-md mt-6" data-split>Inscripción al <span class="text-gold-ink">Liceo.</span></h2>
        <p class="lead mt-5 max-w-xl mx-auto" data-reveal>
          Bachillerato regular en jornada mañana, de grado 6° a 11°. Completa el formulario y te contactamos.
        </p>
      </div>
      <div data-reveal>
        <InscripcionForm selectedProgram="liceo" />
      </div>
    </div>
  </section>
</Layout>

<style>
  .chip-float { animation: bob 6s ease-in-out infinite; }
  .chip-float-2 { animation: bob 7s ease-in-out -3s infinite; }
  .shield-float { animation: bob 8s ease-in-out -1.5s infinite; }
  @keyframes bob { 50% { translate: 0 -10px; } }
  @media (prefers-reduced-motion: reduce) { .chip-float, .chip-float-2, .shield-float { animation: none; } }
</style>
